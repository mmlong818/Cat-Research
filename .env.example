# 复制此文件为 .env 按需填写（全部可选）
# Claude 模型通过本机 Claude Code 调用（使用其登录状态 / 订阅额度），无需 API Key
# 也可用 OpenAI（gpt-6.1-sol / gpt-6-luna）或智谱（glm-5.3 / glm-5.3-flash）的模型，需对应的 API Key

# 核心模型：规划、研究、分析、写作、澄清
CORE_MODEL=claude-opus-5-5
# 辅助模型：评审、来源验证、事实核查、结论验证
SUPPORT_MODEL=claude-sonnet-5-5

# 原生 claude 可执行文件路径（Windows 上 npm 安装的 claude.CMD 无法使用时需要）
# CLAUDE_CLI_PATH=C:\path\to\claude.exe

# OpenAI / 智谱 API Key（优先使用设置页存入系统凭据库的值，这里是兜底）
# OPENAI_API_KEY=
# ZHIPU_API_KEY=

# OpenAI 兼容端点（任意支持 function calling 的 chat.completions 服务；模型名在设置页以 compat:<模型名> 填写）
# COMPAT_BASE_URL=https://api.example.com/v1
# COMPAT_API_KEY=

# 联网搜索后端：zhipu（默认）/ bocha / tavily；智谱与兼容端点的 WebSearch 都用它（设置页的选择优先）
# SEARCH_BACKEND=zhipu
# BOCHA_API_KEY=
# TAVILY_API_KEY=

# ── API 服务安全 ──
# 默认只监听本机；需要局域网访问时显式设置，并把访问用的主机名加入白名单
# API_HOST=0.0.0.0
# CAT_ALLOWED_HOSTS=192.168.1.10,mybox.local
# 开发模式（vite 代理、页面不经后端注入令牌）可关闭令牌校验；Host 校验始终生效
# CAT_API_AUTH=0
